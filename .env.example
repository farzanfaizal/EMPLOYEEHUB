# =============================================
# DJANGO SETTINGS
# =============================================
SECRET_KEY=your-secret-key-here-generate-with-command-below
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com

# Generate SECRET_KEY with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# =============================================
# DATABASE CONFIGURATION
# =============================================
# For local development (SQLite)
USE_SQLITE=True

# For production (PostgreSQL - Render/Neon)
# USE_SQLITE=False
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_HOST=your-database-host.neon.tech
# DB_PORT=5432

# =============================================
# GOOGLE OAUTH CREDENTIALS
# =============================================
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Authorized redirect URIs (add in Google Console):
# http://localhost:8000/accounts/google/login/callback/
# https://your-app.onrender.com/accounts/google/login/callback/

# =============================================
# RENDER DEPLOYMENT
# =============================================
RENDER_EXTERNAL_URL=https://your-app.onrender.com
PYTHON_VERSION=3.11.0

# =============================================
# EMAIL CONFIGURATION (Optional)
# =============================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password

# =============================================
# REDIS CACHE (Optional - for production)
# =============================================
REDIS_URL=redis://localhost:6379/0

# =============================================
# SECURITY SETTINGS (Auto-enabled in production)
# =============================================
# These are automatically enabled when DEBUG=False
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
